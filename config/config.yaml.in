mixed-port: __MIHOMO_PROXY_PORT__
allow-lan: false
mode: rule
log-level: info
ipv6: false
external-controller: 127.0.0.1:__MIHOMO_CONTROLLER_PORT__

profile:
  store-selected: true
  store-fake-ip: false

proxy-providers:
  subscription:
    type: file
    path: ./providers/subscription.yaml
    exclude-filter: "剩余|流量|套餐|到期|过期|官网|网站|Traffic|Expire|Remain"
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      timeout: 5000

proxy-groups:
  - name: PROXY
    type: url-test
    use:
      - subscription
    url: https://www.gstatic.com/generate_204
    interval: 300
    timeout: 5000
    tolerance: 50

rules:
  - DOMAIN-SUFFIX,openai.com,PROXY
  - DOMAIN-SUFFIX,ai.com,PROXY
  - DOMAIN-SUFFIX,chatgpt.com,PROXY
  - MATCH,PROXY
