#!/usr/bin/env bash
set -euo pipefail

group="${MIHOMO_GROUP:-PROXY}"
index_arg=""
api_arg="${MIHOMO_API:-}"

usage() {
  cat <<'EOF'
Usage: mihomo-pick-node [--group GROUP] [--api URL] [index]

Select a Mihomo node by the original provider order.

Examples:
  mihomo-pick-node
  mihomo-pick-node 8
  mihomo-pick-node --group PROXY 8

Options:
  --group GROUP   Proxy group name, default: PROXY
  --api URL       Mihomo controller URL, default: read from config.yaml
  -h, --help      Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --group)
      [ "$#" -ge 2 ] || { echo "Missing value for --group" >&2; exit 2; }
      group="$2"
      shift 2
      ;;
    --api)
      [ "$#" -ge 2 ] || { echo "Missing value for --api" >&2; exit 2; }
      api_arg="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$index_arg" ]]; then
        echo "Only one index is allowed." >&2
        usage >&2
        exit 2
      fi
      index_arg="$1"
      shift
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  if [ "$#" -gt 1 ]; then
    echo "Only one index is allowed." >&2
    usage >&2
    exit 2
  fi
  if [[ -n "$index_arg" ]]; then
    echo "Only one index is allowed." >&2
    usage >&2
    exit 2
  fi
  index_arg="$1"
fi

detect_api() {
  local cfg controller
  cfg="${MIHOMO_CONFIG:-$HOME/.config/mihomo/config.yaml}"
  if [[ -f "$cfg" ]]; then
    controller="$(awk '/^[[:space:]]*external-controller:[[:space:]]*/ {print $2; exit}' "$cfg")"
    controller="${controller//\"/}"
    controller="${controller//\'/}"
    if [[ -n "$controller" ]]; then
      printf 'http://%s\n' "$controller"
      return 0
    fi
  fi
  printf 'http://127.0.0.1:31990\n'
}

api="${api_arg:-$(detect_api)}"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

encoded_group="$(
  python3 - "$group" <<'PY'
from urllib.parse import quote
import sys

print(quote(sys.argv[1], safe=""))
PY
)"

curl -fsSL "${api}/proxies/${encoded_group}" -o "$tmp"

python3 - "$tmp" "$api" "$group" "$index_arg" <<'PY'
import json
import subprocess
import sys
from urllib.parse import quote

path = sys.argv[1]
api = sys.argv[2]
group = sys.argv[3]
index_arg = sys.argv[4]

with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

choices = data.get("all", [])
if not choices:
    print("No nodes returned by Mihomo.", file=sys.stderr)
    sys.exit(1)

current = data.get("now", "")
print(f"Current group: {group}")
print(f"Current node: {current}")
for i, name in enumerate(choices):
    marker = "*" if name == current else " "
    print(f"[{i:>2}]{marker} {name}")

if index_arg:
    index = index_arg.strip()
else:
    if not sys.stdin.isatty():
        print("No TTY input. Use: mihomo-pick-node <index>", file=sys.stderr)
        sys.exit(2)
    index = input("Select index: ").strip()

if not index.isdigit():
    print("Index must be a number.", file=sys.stderr)
    sys.exit(1)

idx = int(index)
if idx < 0 or idx >= len(choices):
    print(f"Index out of range: {idx}", file=sys.stderr)
    sys.exit(1)

selected = choices[idx]
payload = json.dumps({"name": selected})
subprocess.run(
    [
        "curl",
        "-fsSL",
        "-X",
        "PUT",
        f"{api}/proxies/{quote(group, safe='')}",
        "-H",
        "Content-Type: application/json",
        "-d",
        payload,
    ],
    check=True,
)
print(f"Selected node: {selected}")
PY
